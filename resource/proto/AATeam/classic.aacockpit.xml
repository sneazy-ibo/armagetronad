<?xml version="1.0" encoding="ISO-8859-1" standalone="no"?>
<!DOCTYPE Resource SYSTEM "cockpit.dtd">

<Resource type="aacockpit" name="classic" version="0.0.1" author="wrtlprnft" category="">
        <!-- Classic cockpit recreation. The score block uses fixed lines like 0.2.9
             ("Me:  Top:") rather than a table, whose cell alignment differs between
             clients. -->
    <Cockpit version="0.0.1">
	<!-- Template for all needle gauges -->
	<WidgetTemplate id="ng">
            <Position x="0." y="-0.9" />
            <Size height="0.131" width="0.131" />
            <ShowCurrent value="true" />
            <ShowMaximum value="true" />
            <ShowMinimum value="true" />
            <Foreground>
                <Solid>
                    <Color r=".5" g=".5" b="1." alpha="1." />
                </Solid>
            </Foreground>
	</WidgetTemplate>
	<!-- Template for text displays; sizes are 0.2.9's cell metrics (cell 0.039, ink = half a cell) -->
	<WidgetTemplate id="text">
            <Size height="0.0273" width="0.0137" />
	</WidgetTemplate>

        <!-- speed meter -->
        <NeedleGauge usetemplate="ng">
            <DataSet>
                <AtomicData field="source" source="player_speed" />
                <AtomicData field="minimum" source="0" />
                <AtomicData field="maximum" source="max_speed" />
            </DataSet>
            <Caption location="bottom">
                <Text value="0xff3333Speed" />
            </Caption>
        </NeedleGauge>

        <!-- rubber meter -->
        <NeedleGauge usetemplate="ng">
            <DataSet>
                <AtomicData field="source" source="player_rubber" />
                <AtomicData field="minimum" source="0" />
                <AtomicData field="maximum" source="cycle_rubber" />
            </DataSet>
            <Position x="-0.48" y="0." />
            <Caption location="bottom">
                <Text value="0xff3333Rubber" />
            </Caption>
        </NeedleGauge>

	<!-- brake meter -->
        <NeedleGauge usetemplate="ng">
            <DataSet>
                <AtomicData field="source" source="player_brakes" />
                <AtomicData field="minimum" source="0" />
                <AtomicData field="maximum" source="1" />
            </DataSet>
            <Position x="0.48" y="0." />
            <Caption location="bottom">
                <Text value="0xff3333Brakes" />
            </Caption>
        </NeedleGauge>

        <!-- Enemies: x Mates: y display -->
        <Label usetemplate="text">
            <DataSet id="enemies">
                <AtomicData field="source" source="enemies_alive" />
            </DataSet>
            <DataSet id="friends">
                <AtomicData field="source" source="friends_alive" />
            </DataSet>
            <Position x="0.26" y="-0.94" />
            <Size height="1.18" width="1.18" />
            <Caption location="off">
                <Text value="Player Status" />
            </Caption>
            <Face>
                <Table>
                    <Row>
                        <Cell><Text value="0xfefefeEnemies:" /></Cell>
                        <Cell><Text value="0xfefefe" /><GameData data="enemies" /></Cell>
                        <Cell><Text value="0xfefefeFriends:" /></Cell>
                        <Cell><Text value="0xfefefe" /><GameData data="friends" /></Cell>
                    </Row>
                </Table>
            </Face>
        </Label>

	<!-- ping -->
        <Label usetemplate="text">
            <DataSet id="ping">
                <AtomicData field="source" source="current_ping" />
            </DataSet>
            <Position x="0.72" y="-0.94" />
            <Size height="1.18" width="1.18" />
            <Caption location="off">
                <Text value="Player Status" />
            </Caption>
            <Face>
                <Table>
                    <Row>
                        <Cell><Text value="0xfefefePing:" /></Cell>
                        <Cell><Text value="0xfefefe" /><GameData data="ping" /></Cell>
                    </Row>
                </Table>
            </Face>
        </Label>

	<!-- fastest -->
        <Label usetemplate="text">
            <DataSet id="number">
                <AtomicData source="fastest_speed_round" />
            </DataSet>
            <DataSet id="name">
                <AtomicData source="fastest_name_round" />
            </DataSet>
            <Position x="-0.36" y="-0.94" />
            <Size height="1.18" width="1.18" />
            <Caption location="off">
                <Text value="Fastest" />
            </Caption>
            <Face>
                <Table>
                    <Row>
                        <Cell><Text value="0xbf9d50Fastest: " /><GameData data="name" /></Cell>
                        <Cell><Text value="0xbf9d50" /><Text value="(" /><GameData data="number" /><Text value=")" /></Cell>
                    </Row>
                </Table>
            </Face>
        </Label>

	<!-- scores -->
        <Label usetemplate="text">
            <DataSet id="myscore">
                <AtomicData source="current_score" />
            </DataSet>
            <DataSet id="topscore">
                <AtomicData source="top_score" />
            </DataSet>
            <DataSet id="color">
                <Conditional field="source" lvalue="current_score" rvalue="top_score" operator="eq">
                    <IfTrue>
                        <AtomicData source="0xff9d50" />
                    </IfTrue>
                    <IfFalse>
                        <Conditional lvalue="current_score" rvalue="top_score" operator="gt">
                            <IfTrue>
                                <AtomicData source="0x11ff11" />
                            </IfTrue>
                            <IfFalse>
                                <AtomicData source="0x11ffff" />
                            </IfFalse>
                        </Conditional>
                    </IfFalse>
                </Conditional>
            </DataSet>
            <Position x="-0.84" y="-0.904" />
            <Size height="1.3" width="2.0" />
            <Caption location="top">
                <Text value="Scores" />
            </Caption>
            <Face>
                <Table>
                    <Row>
                        <Cell><Text value="0xefefefMe:  Top:" /></Cell>
                    </Row>
                    <Row>
                        <Cell><GameData data="color" /><GameData data="myscore" /><Text value="     " /><Text value="0xffff00" /><GameData data="topscore" /></Cell>
                    </Row>
                </Table>
            </Face>
        </Label>

	<!-- combined meter for rest -->
        <Label camera="^in" viewport="top">
            <DataSet id="fps">
                <AtomicData source="current_framerate" />
            </DataSet>
            <Position x="0.70" y="0.39" />
            <Size height="0.036" width="0.018" />
            <Caption location="off">
                <Text value="FPS" />
            </Caption>
            <Face>
                <Table>
                    <Row>
                        <Cell><Text value="0xffffffFPS: " /></Cell>
                        <Cell><GameData data="fps" /></Cell>
                    </Row>
                </Table>
            </Face>
        </Label>
        <Map>
            <Position x="0.73" y="-0.72" />
            <Size height="0.25" width="0.25" />
            <Background>
                <Solid>
                    <Color r="1." g="1." b="1." alpha=".2" />
                </Solid>
            </Background>
            <MapModes toggleKey="1">
                <MapMode mode="full" rotation="spawn" />
                <MapMode mode="cycle" rotation="camera" zoomFactor="3" clipMode="ellipse" />
            </MapModes>
        </Map>
    </Cockpit>
</Resource>
