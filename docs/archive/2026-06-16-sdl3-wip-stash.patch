+        std::cerr << "OpenGL Version: " << glVersion << "\n";
+        std::cerr << "OpenGL Renderer: " << glGetString(GL_RENDERER) << "\n";
+        printedVersion = true;
+    }
+    
+    glTexImage2D(GL_TEXTURE_2D, 0, format, tex->w, tex->h, 0,
+                 texformat, GL_UNSIGNED_BYTE, tex->pixels);
+    
+    // Generate mipmaps using OpenGL function
+    typedef void (*GLGENMIPMAPFUNC)(GLenum);
+    GLGENMIPMAPFUNC glGenerateMipmap = (GLGENMIPMAPFUNC)SDL_GL_GetProcAddress("glGenerateMipmap");
+    if (glGenerateMipmap) {
+        glGenerateMipmap(GL_TEXTURE_2D);
+        std::cerr << "Used glGenerateMipmap\n";
+    } else {
+        // Fallback: manual mipmap generation
+        std::cerr << "glGenerateMipmap not available, using manual mipmaps\n";
+        int w = tex->w, h = tex->h;
+        int level = 1;
+        unsigned char *pixels = (unsigned char *)tex->pixels;
+        int bpp = tex->format->BytesPerPixel;
+        
+        while (w > 1 || h > 1) {
+            int nw = (w / 2) > 0 ? (w / 2) : 1;
+            int nh = (h / 2) > 0 ? (h / 2) : 1;
+            
+            unsigned char *next_pixels = new unsigned char[nw * nh * bpp];
+            
+            for (int y = 0; y < nh; y++) {
+                for (int x = 0; x < nw; x++) {
+                    for (int c = 0; c < bpp; c++) {
+                        int src_x = (x * 2) < w ? (x * 2) : (w - 1);
+                        int src_y = (y * 2) < h ? (y * 2) : (h - 1);
+                        int idx = (src_y * w + src_x) * bpp + c;
+                        next_pixels[(y * nw + x) * bpp + c] = pixels[idx];
+                    }
+                }
+            }
+            
+            glTexImage2D(GL_TEXTURE_2D, level, format, nw, nh, 0,
+                         texformat, GL_UNSIGNED_BYTE, next_pixels);
+            delete[] next_pixels;
+            
+            w = nw;
+            h = nh;
+            level++;
+        }
+    }
+    
+    GLenum err = glGetError();
+    if (err != GL_NO_ERROR) {
+        std::cerr << "OpenGL error in texture upload: " << err << "\n";
+    }
 
     sr_UnlockSDL();
  #endif
